# Copia este archivo a terraform.tfvars y ajusta lo que necesites.
# terraform.tfvars está en .gitignore: no se sube al repo.
# Las variables que no pongas aquí usan su valor por defecto (variables.tf).

environment       = "dev"
availability_zone = "sa-east-1a"
instance_type     = "t3.micro"
data_volume_size  = 10
