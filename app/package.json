{
  "name": "atk",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.ts",
    "test": "npm run test --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "dev:web": "npm run dev -w @atk/web",
    "dev:api": "node apps/api/src/cli/demo.ts",
    "db:probar": "./db/probar.sh"
  }
}
